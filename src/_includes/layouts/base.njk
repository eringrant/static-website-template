<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  
  <!-- Open Graph -->
  <meta property="og:type" content="{% if tags %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:locale" content="en_US">
  {% if image %}
  <meta property="og:image" content="{{ site.url }}{{ image }}">
  <meta property="og:image:alt" content="{{ imageAlt or title or site.title }}">
  {% endif %}
  
  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  {% if image %}
  <meta name="twitter:image" content="{{ site.url }}{{ image }}">
  <meta name="twitter:image:alt" content="{{ imageAlt or title or site.title }}">
  {% endif %}
  
  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  
  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS Feed" href="{{ site.url }}/feed.xml">
  
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  {% include "components/skip-link.njk" %}
  
  <div class="container">
    {% include "components/header.njk" %}

    <main id="main">
      {{ content | safe }}
    </main>

    {% include "components/footer.njk" %}
  </div>
  
  <script src="/assets/js/main.js"></script>
</body>
</html>